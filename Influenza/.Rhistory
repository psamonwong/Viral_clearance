library(rstan)
stan_code = "functions {
vector SIR(real t, vector y, vector theta, array[] real x_r, array[] int x_i) {
real S = y[1];
real I = y[2];
real R = y[3];
real beta = theta[1];
real gamma = x_r[1];
vector[3] output;
output[1] = -beta * S * I / x_i[1]; // dS_dt
output[2] = beta * S * I / x_i[1] - gamma * I; // dI_dt
output[3] = gamma * I; // dR_dt
return output;
}
}
data {
int<lower=1> T;
array[T] real ts;
int<lower=1> N;
array[T] int I_obs;
real<lower=0> gamma;
}
parameters {
real<lower=0> beta;
real<lower=0, upper=N> S0;
// latent parameter
real<lower=0, upper=N> I0;
// latent parameter
}
transformed parameters {
array[T] vector[3] y_hat; // size of each compartment at each time step
vector[3] y0; // initial status
real t0=0; // time for the initial status
vector[1] theta;
theta[1] = beta;
y0[1] = S0;
y0[2] = I0;
y0[3] = N - S0 - I0;
y_hat = ode_rk45(SIR, y0, t0, ts, theta, {gamma}, {N});
}
model {
beta ~ normal(0.5, 1);
S0 ~ uniform(0, N);
I0 ~ uniform(0, N);
for (t in 1:T) {
I_obs[t] ~ poisson(y_hat[t,2]);
}
}
generated quantities {
array[T] real y_rep;
for (t in 1:T)
y_rep[t] = poisson_rng(y_hat[t,2]);
}"
# we recommend running this in a fresh R session or restarting your current session
###c. run the model and drive the posterior estimates
writeLines(stan_code, 'model.stan')
example(stan_model, package = "rstan", run.dontrun = TRUE)
library(cmdstanr)
library(rstan)
time <- 1:30
I_obs <- c(1, 3, 8, 20, 40, 55, 70, 90, 85, 80, 70, 60, 50, 40, 30, 25, 20, 15, 10, 8, 6, 5, 4, 3, 2, 1,
1,1,1,0)
data_list <- list(
N = 1000, # total population
K = length(time), # number of time points
ts = time, # time vector
I_obs = I_obs, # observed infectious
gamma = 0.2   # fixed recovery rate
)
fit <- stan(file = "model.stan",iter = 2000, chains = 4, warmup = 1000,verbose = T)
stan_code = "functions{
vector sir(real t, vector y, vector theta){
real S = y[1];
real I = y[2];
real R = y[3];
real beta = theta[1];
real gamma = theta[2];
real N = theta[3];
vector[3] output;
output[1] = -beta * S * I / N;
output[2] = beta * S * I /N - gamma * I;
output[3] = gamma * I ;
return output;
}
}
data{
int<lower=1> K;
array[K] real ts;
int<lower=1> N;
array[K] int I_obs;
real<lower=0> gamma;
}
parameters{
real<lower=0> beta;
real<lower=0, upper=N> S0;
real<lower=0, upper=N> I0;
}
transformed parameters{
array[K] vector[3] y_hat;
vector[3] y0;
real t0=0;
vector[3] theta;
theta[1] = beta;
theta[2] = gamma;
theta[3] = N;
y0[1] = S0;
y0[2] = I0;
y0[3] = N - S0 - I0;
y_hat = ode_rk45(sir, y0, t0,ts,theta);
}
model{
beta ~ normal(10,5);
S0 ~ uniform(0,N);
I0 ~ uniform(0,N);
for(t in 1:K)
I_obs[t] ~ poisson(y_hat[t,2]);
}
generated quantities{
array[K] real y_rep;
for(t in 1:K)
y_rep[t] = poisson_rng(y_hat[t,2]);
}"
